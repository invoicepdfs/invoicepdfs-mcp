{
  "name": "@invoicepdfs/mcp",
  "version": "0.1.1",
  "mcpName": "io.github.invoicepdfs/mcp",
  "description": "MCP server for the InvoicePDFs API",
  "homepage": "https://invoicepdfs.com/docs/guides/mcp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invoicepdfs/invoicepdfs-mcp.git"
  },
  "bugs": "https://github.com/invoicepdfs/invoicepdfs-mcp/issues",
  "license": "MIT",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "invoice",
    "pdf",
    "e-invoicing"
  ],
  "type": "module",
  "bin": {
    "invoicepdfs-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "openapi.json",
    "manifest.json"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "node scripts/vendor-spec.mjs",
    "postpack": "node scripts/vendor-spec.mjs --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
